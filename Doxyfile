# Doxygen configuration for PCA9555
# Generated and maintained for unified API documentation.

PROJECT_NAME           = "PCA9555"
PROJECT_NUMBER         = "3.0.2"
PROJECT_BRIEF          = "PCA9555 embedded library API documentation"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO
# Graphviz diagrams are not part of the documentation contract. Pin this value
# because Doxygen defaults differ across supported host packages.
HAVE_DOT               = NO

# Keep the generated reference focused on public headers and durable guides.
# Runnable examples are linked from README and validated by their build gates.
# Keep docs/README.md out of INPUT: Doxygen 1.9.8 otherwise treats both README
# files as main-page blocks and fails the strict warning gate.
INPUT                  = README.md \
                         CHANGELOG.md \
                         CONTRIBUTING.md \
                         SECURITY.md \
                         include \
                         docs/chip_notes.md \
                         docs/espidf.md \
                         docs/hardware_validation.md \
                         docs/register_reference.md \
                         docs/datasheet_extraction.md
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.pio/* */.git/* */test/* */docs/doxygen/*
# Hide generated preprocessor overrides; typed Version.h constants remain public.
EXCLUDE_SYMBOLS        = PCA9555_*
EXAMPLE_PATH           = examples/01_basic_bringup_cli examples/espidf_basic examples/common

USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
